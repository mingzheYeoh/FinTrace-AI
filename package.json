{
  "name": "fintrace-ai",
  "version": "0.1.0",
  "private": true,
  "description": "FinTrace AI — Phase 0 frontend prototype. Turn financial reports into traceable insights.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript docs/api/openapi.yaml -o src/lib/api/generated.d.ts",
    "check:api": "npm run generate:api && npm run typecheck"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@tanstack/react-query": "^5.102.2",
    "antd": "^6.6.1",
    "next": "^16.3.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
